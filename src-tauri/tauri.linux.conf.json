{
    "$schema": "https://schema.tauri.app/config/2",
    "build": {
        "beforeBuildCommand": "node scripts/build-frontend.mjs && node scripts/prepare-sidecar-linux.mjs"
    },
    "bundle": {
        "targets": ["deb"],
        "shortDescription": "Aethon - a standalone Linux client for Aether",
        "longDescription": "Connect Linux through Aether with built-in TUN routing, DNS protection, recovery, and no companion proxy application. The Arch Linux package (repo-root PKGBUILD) is the supported install path; the deb target exists for other distributions.",
        "externalBin": [
            "binaries/aether",
            "binaries/xray"
        ],
        "resources": [
            "../third-party/xray-LICENSE.txt",
            "binaries/pt/psiphon-tunnel-core",
            "binaries/pt/lyrebird"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png"
        ],
        "linux": {
            "deb": {
                "depends": [
                    "libwebkit2gtk-4.1-0",
                    "libgtk-3-0t64 | libgtk-3-0",
                    "libayatana-appindicator3-1",
                    "policykit-1 | polkitd",
                    "iproute2",
                    "nftables"
                ]
            }
        }
    }
}
